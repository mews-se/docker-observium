# Copy to .env and fill in before first start.

# Required: password for the observium database user. Compose refuses to start
# until this is set - pick it before the first run, since the database keeps
# whatever password it was initialised with.
DB_PASS=

# Optional overrides.
#DB_NAME=observium
#DB_USER=observium
#HTTP_PORT=8080
TZ=Europe/Stockholm

# Fill both in to get an admin created on first start, if the user table is
# empty. Left empty, no account is made and you create your first one with
# adduser.php.
OBSERVIUM_ADMIN_USER=
OBSERVIUM_ADMIN_PASS=
