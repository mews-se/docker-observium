# Copy to .env and adjust before first start.

# Required: password for the observium database user.
DB_PASS=change-me

# Optional overrides.
#DB_NAME=observium
#DB_USER=observium
#HTTP_PORT=8080
TZ=Europe/Stockholm

# Created on first start if the user table is empty. Remove or leave
# empty to skip and create your first admin manually with adduser.php.
OBSERVIUM_ADMIN_USER=admin
OBSERVIUM_ADMIN_PASS=change-me-too
